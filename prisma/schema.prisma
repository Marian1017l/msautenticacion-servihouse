generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                           String    @id @default(auto()) @map("_id") @db.ObjectId
  user_name                    String    @unique
  full_name                    String
  email                        String    @unique
  phone                        String
  password                     String
  rol_id                       String    @db.ObjectId
  rol                          Rol       @relation(fields: [rol_id], references: [id])
  status                       Status    @default(PENDING)
  two_fa_code                  String?
  two_fa_expiration            DateTime?
  verification_code            String?
  verification_code_expiration DateTime?
  reset_password_hash          String?
  reset_password_expiration    DateTime?
  city                         String
  department                   String
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
}

model Rol {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

enum Status {
  ACTIVE
  INACTIVE
  PENDING
}
